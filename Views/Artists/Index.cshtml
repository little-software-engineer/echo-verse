@model List<Artist>

@{
    var q = Context.Request.Query["search"].ToString();
    var sortOrder = Context.Request.Query["sortOrder"].ToString();
}

<div class="content-width page-header">

    <div class="search-section">

        <form method="get"
              class="search-form"
              action="@Url.Action("Index", "Artists")">

            
            <div class="autocomplete-wrapper">

                <input type="text"
                       id="searchInput"
                       name="search"
                       value="@q"
                       placeholder="Artist or album…"
                       autocomplete="off"
                       aria-label="Search by artist or album title" />

                <div id="suggestions"
                     role="listbox"
                     aria-live="polite">
                </div>

            </div>

         
            <select name="sortOrder" aria-label="Sort artists">

                @{
                    var sortOptions = new (string Value, string Label)[]
                    {
                                ("newest", "Newest Added"),
                                ("oldest", "Oldest Added")
                    };

                    foreach (var (optValue, optLabel) in sortOptions)
                    {
                        var isSelected =
                        string.Equals(sortOrder,
                        optValue,
                        StringComparison.OrdinalIgnoreCase);

                        if (isSelected)
                        {
                            <option value="@optValue" selected>
                                @optLabel
                            </option>
                        }
                        else
                        {
                            <option value="@optValue">
                                @optLabel
                            </option>
                        }
                    }
                }

            </select>

            <button type="submit" class="btn btn-primary">
                Apply Filters
            </button>

        </form>

    </div>

    <h1 class="page-title">Artists</h1>

    <div class="card-grid">

        @foreach (var artist in Model)
        {
            <a asp-controller="Artists"
               asp-action="Details"
               asp-route-id="@artist.Id"
               class="card @artist.Era">

                <div class="card-image">

                    <img src="@artist.ImageUrl"
                         alt="@artist.Name" />

                </div>

                <div class="card-content">

                    <h2>@artist.Name</h2>

                    <p>@artist.Bio</p>

                    <span class="mood-tag">
                        @artist.Mood
                    </span>

                </div>

            </a>
        }

    </div>

</div>

<script>

    const input = document.getElementById("searchInput");
    const suggestions = document.getElementById("suggestions");

    input.addEventListener("keyup", async () => {

        const term = input.value;

        
        if (term.length < 2) {
            suggestions.innerHTML = "";
            return;
        }

       
        const response = await fetch(
            `/Artists/SearchSuggestions?term=${encodeURIComponent(term)}`
        );

        const data = await response.json();

        suggestions.innerHTML = "";

        
        data.forEach(item => {

            let html = `
                <a href="/Artists/Details/${item.id}"
                   class="suggestion-link">

                    <div class="suggestion-item">

                        <strong>${item.artist}</strong>
            `;

            item.albums.forEach(album => {
                html += `<div>${album}</div>`;
            });

            html += `
                    </div>

                </a>
            `;

            suggestions.innerHTML += html;
        });

    });


    document.addEventListener("click", (e) => {

        if (!e.target.closest(".autocomplete-wrapper")) {
            suggestions.innerHTML = "";
        }

    });

</script>