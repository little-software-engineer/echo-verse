@model Artist

<a asp-controller="Artists"
   asp-action="Details"
   asp-route-id="@Model.Id"
   class="back-arrow">
    &larr;
</a>

<h1 class="timeline-title">@Model.Name</h1>

<div class="timeline-container">

    @foreach (var album in Model.Albums.OrderBy(a => a.Year))
    {
        <section class="era-section @album.Era fade-in">

            <div class="era-content">

               
                <div class="era-text">
                    <span class="year">@album.Year</span>
                    <h2>@album.Title</h2>
                    <p>@album.Description</p>
                    @if (!string.IsNullOrEmpty(album.SpotifyEmbedUrl))
                    {
                        <div class="spotify-player">

                            <iframe style="border-radius:12px"
                                    src="@album.SpotifyEmbedUrl"
                                    width="100%"
                                    height="152"
                                    frameborder="0"
                                    allowfullscreen=""
                                    allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                                    loading="lazy">
                            </iframe>

                        </div>
                    }

                    <div class="timeline-cta-row">
                        <a asp-controller="Artists" asp-action="Details" asp-route-id="@Model.Id" class="btn btn-secondary">Artist profile</a>
                    </div>

                    
                    <div class="inspirations">

                        @if (album.Inspirations != null && album.Inspirations.Any())
                        {
                            <h4>Inspirations</h4>
                            <p class="inspirations-lead">Tap a tile to open a Google search</p>

                            <div class="inspo-grid">
                                @foreach (var inspo in album.Inspirations)
                                {
                                   var searchUrl = WebSearchLinks.GoogleSearch(inspo.Title + " " + inspo.Type);
                                    var label = !string.IsNullOrWhiteSpace(inspo.Type) ? inspo.Type : inspo.Title;
                                    var thumbLetter = label.Trim().Length > 0 ? char.ToUpperInvariant(label.Trim()[0]) : '?';

                                    <a class="inspo-card inspo-card--link"
                                       href="@searchUrl"
                                       target="_blank"
                                       rel="noopener noreferrer"
                                       title="Google: @inspo.Title"
                                       aria-label="Search Google for @inspo.Title">

                                        @if (!string.IsNullOrWhiteSpace(inspo.ImageUrl))
                                        {
                                            <img src="@inspo.ImageUrl" alt="" loading="lazy" decoding="async" />
                                        }
                                        else
                                        {
                                            <div class="inspo-thumb" aria-hidden="true">@thumbLetter</div>
                                        }

                                        <div class="inspo-info">
                                            <span class="inspo-type">@inspo.Type</span>
                                            <p>@inspo.Title</p>
                                            <div class="inspo-meta">
                                                <span class="inspo-hint">Search</span>
                                            </div>
                                        </div>
                                    </a>
                                }
                            </div>
                        }

                    </div>
                </div>

                
                <div class="era-image era-visual" data-era-visual>
                    <img src="@album.ImageUrl" alt="@album.Title" loading="lazy" decoding="async" />
                </div>

            </div>

        </section>
    }

</div>

<script>
   
    const elements = document.querySelectorAll(".fade-in");

    const observer = new IntersectionObserver(entries => {
        entries.forEach(entry => {
            if (entry.isIntersecting) {
                entry.target.classList.add("visible");
            }
        });
    });

    elements.forEach(el => observer.observe(el));



    (function () {
        const frames = document.querySelectorAll("[data-era-visual]");
        if (!frames.length) return;

        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
        if (reduceMotion.matches) return;

        const maxShiftPx = 26;
        const scale = 1.07;
        const sensitivity = 0.065;

        function clamp(n, min, max) {
            return Math.min(max, Math.max(min, n));
        }

        let ticking = false;
        function update() {
            ticking = false;
            const vh = window.innerHeight || 1;
            const mid = vh * 0.5;

            frames.forEach((frame) => {
                const img = frame.querySelector("img");
                if (!img) return;

                const r = frame.getBoundingClientRect();
                if (r.bottom < 0 || r.top > vh) {
                    img.style.transform = `translate3d(0, 0, 0) scale(${scale})`;
                    return;
                }

                const center = r.top + r.height * 0.5;
                const delta = center - mid;
                const y = clamp(-delta * sensitivity, -maxShiftPx, maxShiftPx);
                img.style.transform = `translate3d(0, ${y.toFixed(2)}px, 0) scale(${scale})`;
            });
        }

        function onScroll() {
            if (!ticking) {
                ticking = true;
                requestAnimationFrame(update);
            }
        }

        window.addEventListener("scroll", onScroll, { passive: true });
        window.addEventListener("resize", onScroll, { passive: true });
        update();
    })();
</script>