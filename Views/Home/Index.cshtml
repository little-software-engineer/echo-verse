@model HomeIndexViewModel

<div class="hero-slider full-bleed">

    @for (var i = 0; i < Model.HeroSlides.Count; i++)
    {
        <div class="slide @(i == 0 ? "active" : null)" style="background-image: url('@Model.HeroSlides[i]');"></div>
    }

    <div class="hero-overlay">
        <p class="hero-kicker">Music discovery</p>
        <h1>EchoVerse</h1>
        <p>
            Cinematic timelines, visual eras, and the space where records meet film and games.
        </p>
        <div class="hero-buttons">
            <a asp-controller="Artists" asp-action="Index" class="btn btn-primary btn-lg">Browse artists</a>
            <a href="#discover" class="btn btn-outline btn-lg">What we offer</a>
        </div>
    </div>

</div>

<section id="discover" class="home-info content-width" aria-labelledby="discover-heading">
    <h2 id="discover-heading" class="visually-hidden">Features</h2>
    <div class="info-card">
        <h2>Timelines</h2>
        <p>
            Scroll eras with full-screen visuals and short stories behind each chapter.
        </p>
    </div>
    <div class="info-card">
        <h2>Inspirations</h2>
        <p>
            See how albums nod to cinema, games, and visual culture in one place.
        </p>
    </div>
</section>

<script>
    const slides = document.querySelectorAll(".slide");
    if (slides.length > 0) {
        let current = 0;
        setInterval(() => {
            slides[current].classList.remove("active");
            current = (current + 1) % slides.length;
            slides[current].classList.add("active");
        }, 4500);
    }
</script>
