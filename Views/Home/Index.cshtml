@model HomeIndexViewModel



<section class="hero-video-section full-bleed">

    <video autoplay
           muted
           loop
           playsinline
           class="hero-video">

        <source src="~/videos/appVideo.mp4" type="video/mp4" />

    </video>

    <div class="hero-overlay">

        <p class="hero-kicker">
            Music discovery
        </p>

        <h1>
            EchoVerse
        </h1>

        <p class="hero-description">
            Cinematic timelines, visual eras,
            and the space where records meet film and games.
        </p>

        <div class="hero-buttons">

            <a asp-controller="Artists"
               asp-action="Index"
               class="btn btn-primary btn-lg">

                Browse artists

            </a>

            <a href="#discover"
               class="btn btn-outline btn-lg">

                What we offer

            </a>

        </div>

    </div>

</section>

<section id="discover"
         class="home-info content-width"
         aria-labelledby="discover-heading">

    <h2 id="discover-heading" class="visually-hidden">
        Features
    </h2>

    <div class="info-card">

        <h2>
            Timelines
        </h2>

        <p>
            Scroll eras with cinematic visuals
            and immersive album storytelling.
        </p>

    </div>

    <div class="info-card">

        <h2>
            Inspirations
        </h2>

        <p>
            Explore references to movies,
            video games, aesthetics and visual culture.
        </p>

    </div>

    <div class="info-card">

        <h2>
            Atmosphere
        </h2>

        <p>
            Designed as a cinematic digital experience
            instead of a traditional music database.
        </p>

    </div>

</section>




